PORT=5000
# Set this in Render's Environment Variables dashboard (not here) to enable keep-alive self-pinging.
# Example: RENDER_BACKEND_URL=https://brahmi-api.onrender.com
# RENDER_BACKEND_URL=
JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas Connection String
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Replace <user>, <pass>, and <cluster> with your values
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/brahmi?retryWrites=true&w=majority"
